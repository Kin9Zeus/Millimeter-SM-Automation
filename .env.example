# Copia a .env para desarrollo local. En Railway estas son "Variables" del servicio.
# NUNCA subas el .env real: este repositorio es público.

# --- Gemini (https://aistudio.google.com/apikey · requiere facturación activa para Nano Banana Pro) ---
GEMINI_API_KEY=
# Opcional: fuerza un modelo de texto concreto. Si se omite, el bot prueba una lista de candidatos.
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=gemini-3-pro-image
IMAGE_SIZE=2K
IMAGE_ASPECT=4:5

# --- Meta · Instagram Login (token de larga duración, 60 días; el bot lo renueva solo) ---
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_API_VERSION=v22.0

# --- Programación ---
TZ_NAME=America/Bogota
POST_HOUR=10
POST_MINUTE=0

# --- Hosting de la imagen (Meta exige URL pública) ---
# En Railway se deduce de RAILWAY_PUBLIC_DOMAIN; define esto solo si usas dominio propio.
PUBLIC_BASE_URL=
# Carpeta persistente (en Railway: monta un Volume en /data y pon DATA_DIR=/data)
DATA_DIR=./data

# --- Seguridad / control ---
# Habilita POST /admin/run y GET /admin/status (envía "Authorization: Bearer <token>"). Vacío = deshabilitado.
ADMIN_TOKEN=
# Interruptor de emergencia: true = el bot no publica nada.
PAUSED=false
# true = genera todo pero NO publica (para probar).
DRY_RUN=false

# --- Avisos opcionales por Telegram (solo notificación, no aprobación) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
